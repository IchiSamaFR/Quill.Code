<Project>
	<!-- Package versions, once for the whole solution (csproj files specify no Version). -->
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>

	<ItemGroup>
		<!-- C#: completion, diagnostics, hover, signature help. Same version as Querify. -->
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Features" Version="5.0.0" />

		<!-- SQL Server catalog reading (Quill.Data.Sql.SqlServer). Same version as Querify; 6.1.6 minimum for EF Core SqlServer 10.0.12 (otherwise NU1605). -->
		<PackageVersion Include="Microsoft.Data.SqlClient" Version="6.1.6" />

		<!-- Drivers of the other engines (Quill.Data.Sql.[Engine], Quill.Code.[Engine]): same versions as their EF Core providers. -->
		<PackageVersion Include="MySqlConnector" Version="2.6.2" />
		<PackageVersion Include="Npgsql" Version="10.0.3" />
		<PackageVersion Include="Oracle.ManagedDataAccess.Core" Version="23.26.400" />
		<PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.14" />

		<!-- LINQ: DbContext generated then compiled in memory (Quill.Code.CSharp.Linq). Same version as Querify. -->
		<!-- 10.0.14 minimum: required by Microting.EntityFrameworkCore.MySql 10.0.14. -->
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.14" />
		<PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
		<!-- MySQL: Pomelo has no EF Core 10 version; Microting is its maintained fork, on MySqlConnector. -->
		<PackageVersion Include="Microting.EntityFrameworkCore.MySql" Version="10.0.14" />
		<PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
		<PackageVersion Include="Oracle.EntityFrameworkCore" Version="10.23.26400" />

		<!-- T-SQL: syntax diagnostics. Same version as Querify. -->
		<PackageVersion Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.117.0" />

		<!-- Tests -->
		<PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
		<PackageVersion Include="xunit" Version="2.9.2" />
		<PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
	</ItemGroup>
</Project>
