<Project>
	<!-- Settings shared by all projects: each csproj only keeps what is specific to it. -->
	<PropertyGroup>
		<!-- Next published version: bump after each tag. Published version pinned by -p:Version=<tag>. -->
		<VersionPrefix>0.1.0</VersionPrefix>
		<Authors>IchiSamaFR</Authors>
		<Company>IchiSamaFR</Company>
		<Product>Quill.Code</Product>
		<Copyright>Copyright (c) 2026 IchiSamaFR</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NoWarn>$(NoWarn);CA2007</NoWarn>
	</PropertyGroup>

	<!-- Full code analysis of the libraries; tests are exempt. -->
	<PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
	</PropertyGroup>

	<!-- NuGet packages: metadata, XML documentation and Source Link (PDB embedded in the DLL: no .snupkg to publish). -->
	<PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<IsPackable>true</IsPackable>
		<!-- Quill. prefix reserved by another account on nuget.org: packages are named QuillCode.* (Quill.Code.CSharp -> QuillCode.CSharp,
		     Quill.Data.Sql -> QuillCode.Data.Sql); assemblies and namespaces stay Quill.*. -->
		<PackageId Condition="$(MSBuildProjectName.StartsWith('Quill.Code'))">QuillCode$(MSBuildProjectName.Substring(10))</PackageId>
		<PackageId Condition="$(MSBuildProjectName.StartsWith('Quill.Data'))">QuillCode.$(MSBuildProjectName.Substring(6))</PackageId>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>code-editor;syntax-highlighting;completion;roslyn</PackageTags>
		<RepositoryUrl>https://github.com/IchiSamaFR/Quill.Code</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
