<Project>
	<!-- Reglages communs a tous les projets : chaque csproj ne garde que ce qui lui est propre. -->
	<PropertyGroup>
		<!-- Prochaine version publiee : a monter apres chaque tag. Version publiee figee par -p:Version=<tag>. -->
		<VersionPrefix>0.1.0</VersionPrefix>
		<Authors>IchiSamaFR</Authors>
		<Company>IchiSamaFR</Company>
		<Product>Quill.Code</Product>
		<Copyright>Copyright (c) 2026 IchiSamaFR</Copyright>
	</PropertyGroup>

	<PropertyGroup>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<NoWarn>$(NoWarn);CA2007</NoWarn>
	</PropertyGroup>

	<!-- Analyse complete du code des librairies ; les tests en sont dispenses. -->
	<PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
		<AnalysisLevel>latest-all</AnalysisLevel>
	</PropertyGroup>

	<!-- Paquets NuGet : metadonnees, documentation XML et Source Link (PDB embarque dans la DLL : pas de .snupkg a publier). -->
	<PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<IsPackable>true</IsPackable>
		<!-- Prefixe Quill. reserve par un autre compte sur nuget.org : les paquets s'appellent QuillCode.* (Quill.Code.CSharp -> QuillCode.CSharp,
		     Quill.Data.Sql -> QuillCode.Data.Sql) ; assemblies et namespaces restent Quill.*. -->
		<PackageId Condition="$(MSBuildProjectName.StartsWith('Quill.Code'))">QuillCode$(MSBuildProjectName.Substring(10))</PackageId>
		<PackageId Condition="$(MSBuildProjectName.StartsWith('Quill.Data'))">QuillCode.$(MSBuildProjectName.Substring(6))</PackageId>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>code-editor;syntax-highlighting;completion;roslyn</PackageTags>
		<RepositoryUrl>https://github.com/IchiSamaFR/Quill.Code</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
		<None Include="$(MSBuildThisFileDirectory)..\README.md" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>
</Project>
