<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- EF Core 10 only targets net10.0. -->
		<TargetFramework>net10.0</TargetFramework>
		<RootNamespace>Quill.Code.CSharp.Linq</RootNamespace>
		<Description>LINQ / Entity Framework Core queries for Quill.Code, engine-agnostic: DbContext generated from a database structure (Quill.Data.Sql), C# completion, diagnostics and hover in that context, execution; the engine comes from an ILinqDatabaseProvider (e.g. Quill.Code.CSharp.Linq.SqlServer).</Description>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Quill.Code.CSharp\Quill.Code.CSharp.csproj" />
		<ProjectReference Include="..\Quill.Data.Sql\Quill.Data.Sql.csproj" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="Quill.Code.Tests" />
	</ItemGroup>

</Project>
